# Copy this file to `.env` (which is gitignored) and set a passcode.
#
#   cp .env.example .env
#   # then edit .env
#
# The passcode unlocks the synced dashboard on each device. Pick something long
# — it is the only thing standing between your boards and anyone who can reach
# the server. There are no usernames; this one passcode is the whole login.
OPENLOO_PASSCODE=change-me-to-something-long
